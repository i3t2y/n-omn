# ⚠ 跟踪副本: 真源在 ~/omn-ops/ghcr/Dockerfile (运行时 omn-ops 无 git 仓, 此副本入 omn-merge 仓
# 防单机 single-copy 机器挂时重建环境层定义失传。不含密钥 (仅 ARG 上游 ref + RUN 装依赖)。
# 改真源后须同步本副本; upstream_check.sh 预构建只用真源 ~/omn-ops/ghcr/Dockerfile。

# ── OmniRoute 永续节点 · 环境层 GHCR 预构建镜像 ──────────────────────
# 三层解耦: 环境层 (本镜像, GHCR) + 逻辑层 (ho/site repo Dockerfile FROM ${BASE_IMAGE} + COPY bootstrap.sh)
# 职责边界: 本镜像仅装"上游镜像 + 运行前置依赖 + 跨版防御 env + /data 软链";
#           不 COPY 任何 gate.js/entrypoint.sh/init/litestream.yml/bootstrap.sh (逻辑层, 走 HF repo build 时 COPY)。
# 预构建契约:
#   upstream_check.sh 检测上游新 release → 本 Dockerfile 本地 build+push 至 GHCR
#   → 审批报告 (TXT, Win11 双击即读) 含"BASE_IMAGE 改为新 tag + Rebuild"
#   人工跑 space_ctl.py upgrade (factory_reboot=True) → 唯一触 HF build 队列动作
# 下半自动: 检测/构建/告警全自动 (零 HF 队列接触); factory rebuild 永远人工触发。
#
# 上游 ENTRYPOINT 漂移 (v3.8.48 已查证): 上游 Dockerfile 自带 ENTRYPOINT ["/tmp/check-permissions.sh"]
#   + CMD ["node","dev/run-standalone.mjs"]。本镜像不覆 ENTRYPOINT (不动上游 CMD),
#   覆盖动作交给 ho/site repo 的 ENTRYPOINT ["/bootstrap.sh"] (那句会盖掉上游 ENTRYPOINT)。
#   故本 Dockerfile 末尾不写 ENTRYPOINT/CMD — 让镜像保留上游 ENTRYPOINT 应急 (若 BASE_IMAGE 直指上游 tag 也能起)。

#── 构建参数: 上游 tag+digest 双锁合并为单 ARG (buildx linter 对双 ARG 透传 FROM 误报 invalid digest length;
#   合一 ARG 形 `image:tag@digest` 与 candidate-v4.3/Dockerfile L7 inline 写法一致, linter 接受)
#   digest 不可变防漂移; 设 build_arg UPSTREAM_REF=tag@digest 即可换上游版 (防 latest 漂致 Turbopack 缓存 mmap hang)
ARG UPSTREAM_REF=3.8.43@sha256:517c160643c56ad72e3e305458d9619a4c87f711393c13020450f9f088d1570
FROM diegosouzapw/omniroute:${UPSTREAM_REF}

#── 跨版防御 env (3.8.43 无害; 防误漂到 3.8.45+ Turbopack 缓存 mmap 失败致 Next 静默 hang) ──
ENV OMNIROUTE_USE_TURBOPACK=0
# 迁移安全阀: 从旧库补多个 migration (含 117 表重建) 时不触发 abort 刷屏中断
ENV OMNIROUTE_MAX_PENDING_MIGRATIONS=0

#── 端口契约 (与上游 Dockerfile ENV PORT=20128 对齐; HF Space app_port=7860 由 gate.js 前置代理) ──
ENV OMNIROUTE_PORT=20128
ENV EXPOSED_PORT=7860
ENV DATA_DIR=/data

# 上游 Dockerfile USER node 且缺运行时自愈工具; bootstrap 需写权限 → 永久 root
USER root

#── 精简依赖: 仅安装运行必需 (--no-install-recommends 减体积; curl/jq/python3/sqlite3 自愈链; ca-certificates 防 TLS 验证挂) ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl jq python3 python3-pip sqlite3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

#── huggingface_hub: bootstrap _dl() 拉 Dataset 逻辑层 + 配置快照上传 ──
RUN pip3 install --no-cache-dir --break-system-packages huggingface_hub

#── Litestream v0.5.9 (修复 R2 InvalidContentEncoding; auto-recover 契约见 litestream.yml v4.3 红线3) ──
# asset 命名: litestream-{VER}-linux-{ARCH}.tar.gz (无 v 前缀; x86_64 非 amd64; aarch64 归一为 arm64)
ARG LITESTREAM_VERSION=0.5.9
# tar 预置于构建上下文 (host 端 curl 一次性拉, 提交 omn-ops/ghcr/ 内), Dockerfile COPY 进容器解包
# 绕 buildkit 容器内 runtime curl 死锁 — github release assets 302 重定向至 release-assets.githubusercontent.com
# CDN, buildkit 容器内 DNS/路由该 CDN 慢或断; 且 release SAS token (se=) 短期过期 curl 无超时会 block 死。
# host 端预拉 (合本 Dockerfile build 时间窗, SAS 未过) + COPY 隔离网络依赖, buildkit 仅做层解 tar。
COPY litestream-${LITESTREAM_VERSION}-linux-x86_64.tar.gz /tmp/litestream.tar.gz
RUN tar -xz -C /usr/local/bin --strip-components=0 litestream -f /tmp/litestream.tar.gz && \
    chmod +x /usr/local/bin/litestream && \
    rm /tmp/litestream.tar.gz && \
    litestream version

#── 数据目录持久化: /data (HF 持久卷) 软链至上游默认 /app/data ──
RUN mkdir -p /data && chmod 777 /data
RUN rm -rf /app/data && ln -sf /data /app/data

EXPOSE 7860

#── 容器级健康检查: start-period=180s 与 bootstrap.sh 内部 180s 等待对齐; 探活 /healthz (gate.js 提供) ──
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -sf http://127.0.0.1:7860/healthz || exit 1

# 不写 ENTRYPOINT/CMD: 保留上游 ENTRYPOINT [%/tmp/check-permissions.sh%] 应急;
# 实际覆盖由 HF repo Dockerfile ENTRYPOINT [%/bootstrap.sh%] 在 build 时完成。
