# 依赖
node_modules/

# SQLite 数据库文件（运行时产物，不入库）
*.db
*.db-shm
*.db-wal

# 环境变量 / 凭证
.env
.env.*

# 密钥文件
*.key
secrets/
*.pem

# pm.py — 含明文 dev key (T+48h 轮换), 绝不入 git
pm.py
pm_*.py

# 临时快照目录
/tmp/omni-snapshot/

# 审计报告（本地工作产物）
audit-report.md

# macOS
.DS_Store

# .claude/ 凭据护栏: 仅忽略 settings*/凭件, skills 流程知识入版本控制共享 team
.claude/settings.json
.claude/settings.local.json
.claude/hooks/_selftest.py
.claude/hooks/*.pyc
.claude/_backup-*/
out/

# Python 字节码缓存 (运行时产物不入库)
__pycache__/
*.pyc

# FlareTunnel 静态二进制产物 (源入库, 产物出局经 sync-logic-xnexus.yml 推 xnexus/logic Bucket, 路3)
/flaretunnel/flaretunnel
/flaretunnel/flaretunnel.bak.*

